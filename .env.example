PUBLIC_URL=http://192.168.1.10:3000
LIBRARY_DIR=./library
# :rw lets the drop page write into the library
LIBRARY_WRITE=:ro
# local build target: runtime (2 MB, EPUB only) or conversion (adds KCC, ~400 MB)
KOBINK_TARGET=runtime
# image tag to pull: latest (EPUB only) or conversion
KOBINK_TAG=latest
# deleting on the reader moves the file into .kobink-trash; off deletes it outright
LIBRARY_TRASH=on
# name in the device's account settings
KOBO_NAME=kobink
# off turns the store shelves (featured, deals, recommendations, nextread) back into empty answers
KOBO_STORE=on
# the container runs as this user; chown ./data and the library to it once
KOBINK_UID=1000
KOBINK_GID=1000
KOBINK_MEMORY=2g
KOBINK_PORT=3000
LIBRARY_REFRESH_SECONDS=600
API_KEY=
RUST_LOG=info
