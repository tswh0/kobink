PUBLIC_URL=http://192.168.1.10:3000
LIBRARY_DIR=./library
# :rw lets the drop page write into the library
LIBRARY_WRITE=:ro
# runtime is 2 MB and takes EPUBs; conversion adds KCC and weighs ~400 MB
KOBINK_TARGET=runtime
# the container runs as this user; chown ./data and the library to it once
KOBINK_UID=1000
KOBINK_GID=1000
KOBINK_MEMORY=2g
KOBINK_PORT=3000
LIBRARY_REFRESH_SECONDS=600
API_KEY=
RUST_LOG=info
